# Flask & App Secret Key
FLASK_SECRET_KEY=sandras-super-secret-key-998877

# Google OAuth Credentials (For Google Calendar & Gmail Sync)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_API_REDIRECT_URI=http://localhost:5000/auth/callback
HOST_EMAIL=your_email@gmail.com
HOST_CALENDAR_ID=primary

# SMTP Email Credentials (For Meeting Summaries & Email Notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Twilio Credentials (For Outbound Telephony Fallback Calls)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AI Model Credentials (Alternative to entering key in UI)
GEMINI_API_KEY=your_gemini_api_key
NVIDIA_API_KEY=your_nvidia_api_key
